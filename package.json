{
  "name": "application",
  "scripts": {
    "dev": "concurrently 'cd apps/backend && bun dev' 'cd apps/frontend-next && bun dev'",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:watch": "bunx onchange . -- biome check --write --no-errors-on-unmatched {{changed}}",
    "prepare": "husky install",
    "stylelint": "stylelint \"{apps,packages}/**/*.css\"",
    "tsc": "bunx tsc"
  },
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@types/bull": "^4.10.4",
    "bun-types": "^1.1.21",
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "stylelint": "^15.11.0",
    "stylelint-config-standard": "^34.0.0",
    "typed-css-modules": "^0.7.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "resolutions": {
    "elysia": "1.4.9",
    "@elysiajs/eden": "1.4.1",
    "nanostores": "0.11.2",
    "esbuild": "0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@swc/core",
    "esbuild",
    "msw",
    "sharp"
  ],
  "dependencies": {
    "dotenv": "^17.2.3",
    "typescript": "^5.5.4"
  },
  "packageManager": "bun@1.2.23"
}
