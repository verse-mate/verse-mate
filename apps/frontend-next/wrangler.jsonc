{
  // Wrangler configuration for VerseMate frontend deployment using OpenNext
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/config-schema.json",
  "name": "verse-mate-production",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-06",
  "account_id": "e8f0b566ba1c8227a25e3784def4300e",

  /**
   * Workers.dev route enabled, in addition to the custom domain
   */
  "workers_dev": true,

  // Environment variables
  "vars": {
    "API_URL": "https://api.verse-mate.apegro.dev",
    "APP_URL": "https://verse-mate.xyz",
    "NEXT_PUBLIC_ASK_VERSE_MATE": "false",
    "POSTHOG_KEY": "phc_UhHXkLHgiD6916hYZgaKy9pjOOlZi9sTRic3RhWWLRC",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "POSTHOG_SESSION_REPLAY": "false"
  },

  // Custom domain routes
  "routes": [
    {
      "pattern": "verse-mate.xyz",
      "custom_domain": true
    }
  ],

  // Node.js compatibility (required for OpenNext)
  "compatibility_flags": ["nodejs_compat"],

  // Static assets configuration for OpenNext
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false
  },

  // KV namespaces for caching
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "148bacc8fbc14a318da7c590a324efb5", // Create with: wrangler kv namespace create CACHE
      "preview_id": "189059813b874bf6b5d27f9b4d3f2f11" // For development
    }
  ],

  // R2 bucket for static assets (optional, more efficient than site.bucket)
  // "r2_buckets": [
  //   {
  //     "binding": "ASSETS",
  //     "bucket_name": "verse-mate-assets"
  //   }
  // ],

  // Development settings
  "dev": {
    "ip": "localhost",
    "port": 8787,
    "local_protocol": "http",
    "upstream_protocol": "https"
  },

  // Environment configurations
  "env": {
    "preview": {
      "name": "v-m-preview-app",
      "vars": {
        "API_URL": "https://api.verse-mate.apegro.dev",
        "APP_URL": "https://v-m-preview-app.verse-mate.workers.dev",
        "NEXT_PUBLIC_ASK_VERSE_MATE": "false",
        "POSTHOG_KEY": "phc_UhHXkLHgiD6916hYZgaKy9pjOOlZi9sTRic3RhWWLRC",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_SESSION_REPLAY": "false"
      }
    },
    "staging": {
      "name": "verse-mate-staging-app",
      "vars": {
        "API_URL": "https://api.verse-mate.apegro.dev",
        "APP_URL": "https://staging.app.verse-mate.xyz",
        "NEXT_PUBLIC_ASK_VERSE_MATE": "false",
        "POSTHOG_KEY": "phc_UhHXkLHgiD6916hYZgaKy9pjOOlZi9sTRic3RhWWLRC",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_SESSION_REPLAY": "false"
      },
      "routes": [
        {
          "pattern": "staging.app.verse-mate.xyz",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "verse-mate-production",
      "vars": {
        "API_URL": "https://api.verse-mate.apegro.dev",
        "APP_URL": "https://app.versemate.org",
        "NEXT_PUBLIC_ASK_VERSE_MATE": "false",
        "POSTHOG_KEY": "phc_UhHXkLHgiD6916hYZgaKy9pjOOlZi9sTRic3RhWWLRC",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "POSTHOG_SESSION_REPLAY": "true"
      },
      "routes": [
        {
          "pattern": "app.versemate.org",
          "custom_domain": true
        }
      ]
    }
  }
}
