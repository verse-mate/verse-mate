{
  // Wrangler configuration for VerseMate frontend deployment to Cloudflare Workers
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler/main/config-schema.json",
  "name": "verse-mate-frontend",
  "compatibility_date": "2024-08-04",
  "account_id": "e8f0b566ba1c8227a25e3784def4300e", // Add your Cloudflare account ID here

  // Main worker entry point (ES Module)
  "main": ".cf/worker/index.js",

  /**
   * Workers.dev route enabled, in addition to the custom domain
   */
  "workers_dev": true,

  // Build configuration
  "build": {
    "command": "bun run build:worker",
    "cwd": "."
  },

  // Static assets configuration
  "assets": {
    "directory": ".cf/public",
    "binding": "ASSETS"
  },

  // Environment variables
  "vars": {
    "API_URL": "https://api.verse-mate.apegro.dev",
    "APP_URL": "https://verse-mate.xyz", // Update with your workers.dev subdomain
    "NEXT_PUBLIC_ASK_VERSE_MATE": "false"
  },

  // Custom domain routes
  "routes": [
    {
      "pattern": "verse-mate.xyz",
      "custom_domain": true
    }
  ],

  // Node.js compatibility
  "compatibility_flags": ["nodejs_compat"],

  // KV namespaces for caching
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "148bacc8fbc14a318da7c590a324efb5", // Create with: wrangler kv namespace create CACHE
      "preview_id": "189059813b874bf6b5d27f9b4d3f2f11" // For development
    }
  ],

  // R2 bucket for static assets (optional, more efficient than site.bucket)
  // "r2_buckets": [
  //   {
  //     "binding": "ASSETS",
  //     "bucket_name": "verse-mate-assets"
  //   }
  // ],

  // Development settings
  "dev": {
    "ip": "localhost",
    "port": 8787,
    "local_protocol": "http",
    "upstream_protocol": "https"
  },

  // Environment configurations
  "env": {
    "preview": {
      "name": "v-m-preview",
      "vars": {
        "API_URL": "https://api.verse-mate.apegro.dev",
        "APP_URL": "https://v-m-preview.verse-mate.workers.dev",
        "NEXT_PUBLIC_ASK_VERSE_MATE": "false"
      }
    },
    "staging": {
      "name": "verse-mate-frontend-staging",
      "vars": {
        "API_URL": "https://api.verse-mate.apegro.dev",
        "APP_URL": "https://staging.verse-mate.xyz",
        "NEXT_PUBLIC_ASK_VERSE_MATE": "false"
      },
      "routes": [
        {
          "pattern": "staging.verse-mate.xyz",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "verse-mate-frontend",
      "vars": {
        "API_URL": "https://api.verse-mate.apegro.dev",
        "APP_URL": "https://verse-mate.xyz",
        "NEXT_PUBLIC_ASK_VERSE_MATE": "false"
      },
      "routes": [
        {
          "pattern": "verse-mate.xyz",
          "custom_domain": true
        }
      ]
    }
  }

  // Tail consumers for logging (optional)
  // "tail_consumers": [
  //   {
  //     "service": "verse-mate-logger"
  //   }
  // ]
}
