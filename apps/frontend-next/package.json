{
  "name": "frontend-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun run next dev --turbo",
    "build": "bun --bun run next build",
    "build:worker": "npx @cloudflare/next-on-pages --outdir .cf/output/static",
    "start": "bun --bun run next start",
    "deploy": "wrangler deploy",
    "preview": "bun run build:worker && wrangler dev"
  },
  "dependencies": {
    "frontend-base": "workspace:*",
    "frontend-envs": "workspace:*",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.13",
    "@types/node": "^20.14.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "postcss-nested": "^6.2.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.27.0"
  }
}
