{
  "name": "frontend-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun run next dev --turbo",
    "build": "bun --bun run next build",
    "lint": "biome check --write --no-errors-on-unmatched",
    "lint:ci": "biome check",
    "tsc": "bunx tsc",
    "build:worker": "opennextjs-cloudflare build",
    "start": "bun --bun run .next/standalone/apps/frontend-next/server.js",
    "deploy": "opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@tanstack/react-query": "^5.59.15",
    "canvas-confetti": "^1.9.4",
    "frontend-base": "workspace:*",
    "frontend-envs": "workspace:*",
    "next": "^15.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.6.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.14.13",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "postcss-nested": "^6.2.0",
    "sharp": "^0.34.3",
    "typescript": "^5.5.4",
    "wrangler": "^4.28.1"
  }
}
