# Email - NOTIFICATION
EMAIL_FROM=no-reply@my-domain.dev
MAILGUN_API_KEY=no-reploy@
MAILGUN_DOMAIN=my-domain.dev

# Authentication
AUTH_ACCESS_TOKEN_SECRET=my-super-secret
AUTH_ACCESS_TOKEN_LIFETIME='1d'
AUTH_HASH_SALT=10

# Application
ENVIRONMENT=development
POSTGRES_URL=postgresql://postgres_user:postgres_password@localhost:5432/postgres_db
REDIS_URL="redis://:abcd1234@localhost:6379/0"

# Object Storage
OBJECT_STORAGE_ACCESS_KEY_ID=some-key-to-be-created
OBJECT_STORAGE_SECRET_ACCESS_KEY=some-key-to-be-created
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET="saas-starter-dev"
OBJECT_STORAGE_REGION=us-east-1

# PORT
PORT=4000

# Open AI
OPEN_AI_KEY=""

# Explanation Audio (TTS)
# TTS_PROVIDER selects the synthesis backend. "stub" returns the fixture MP3
# for any request and bypasses the queue on the reader path; "openai" calls
# OpenAI's audio.speech API (requires OPEN_AI_KEY).
TTS_PROVIDER=stub
TTS_VOICE_EN=nova
TTS_MODEL_OPENAI=tts-1-hd
EXPLANATION_AUDIO_STUB_PATH=./fixtures/explanation-audio-stub.mp3

# SSO Authentication
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Slack Support Chat
SLACK_BOT_TOKEN=
SLACK_SUPPORT_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
