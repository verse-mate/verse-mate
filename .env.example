# VerseMate Environment Configuration

# Notes Feature Configuration
# Set to 'true' to enable notes functionality, 'false' to disable
NEXT_PUBLIC_NOTES_ENABLED=false

# Notes API URL - defaults based on environment if not set
# Development: http://localhost:4000
# Production: https://api.verse-mate.apegro.dev
NEXT_PUBLIC_NOTES_API_URL=https://api.verse-mate.apegro.dev

# Backend Database Configuration
# PostgreSQL connection string for notes storage
POSTGRES_URL=postgresql://username:password@host:port/database

# Example production values:
# NEXT_PUBLIC_NOTES_ENABLED=true
# NEXT_PUBLIC_NOTES_API_URL=https://api.verse-mate.apegro.dev
# POSTGRES_URL=postgresql://prod_user:secure_password@db.verse-mate.com:5432/versemate_prod
