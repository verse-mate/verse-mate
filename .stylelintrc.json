{
  "extends": ["stylelint-config-standard"],
  "ignoreFiles": ["**/dist/**/*.css"],
  "rules": {
    "media-feature-range-notation": null,
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]+$",
      {
        "message": "Expected custom property name to be lowerCamelCase"
      }
    ]
  }
}
