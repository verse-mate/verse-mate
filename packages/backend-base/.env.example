# Email - NOTIFICATION
EMAIL_FROM=no-reply@my-domain.dev
MAILGUN_API_KEY=fake@test.com
MAILGUN_DOMAIN=fale-domain

# Authentication
AUTH_ACCESS_TOKEN_SECRET=my-super-secret
AUTH_ACCESS_TOKEN_LIFETIME='1d'
AUTH_HASH_SALT=10

# Application
ENVIRONMENT=development
POSTGRES_URL=postgresql://postgres_user:postgres_password@localhost:5432/postgres_db
REDIS_URL="redis://:abcd1234@localhost:6379/0"

# Object Storage
OBJECT_STORAGE_ACCESS_KEY_ID=some-key-to-be-created
OBJECT_STORAGE_SECRET_ACCESS_KEY=some-key-to-be-created
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET="saas-starter-dev"
OBJECT_STORAGE_REGION=us-east-1

# Open AI
OPEN_AI_KEY=""

# PostHog Analytics (Backend/Server-side)
# Get your API key from https://app.posthog.com/project/settings
# IMPORTANT: Use separate PostHog projects for dev/staging vs production environments
# - This prevents test data from polluting production analytics
# - Create a separate project in PostHog for each environment
# - Leave empty to disable PostHog tracking (recommended for local development)
POSTHOG_KEY=""
# PostHog host URL (default: https://app.posthog.com for PostHog Cloud)
# Only change this if using self-hosted PostHog or EU cloud (https://eu.posthog.com)
POSTHOG_HOST="https://app.posthog.com"
