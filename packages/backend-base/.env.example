# Email - NOTIFICATION (Google Workspace, Gmail API; queue/consumers/email-notification.consumer.ts)
# Sent only when ENVIRONMENT is production or staging. EMAIL_FROM is the Workspace mailbox the
# refresh token belongs to, or one of its verified "send mail as" aliases. The OAuth client is a
# Google Cloud "Desktop app" client; the refresh token is minted once for that mailbox with the
# scope https://www.googleapis.com/auth/gmail.send.
EMAIL_FROM=no-reply@example.org
EMAIL_FROM_NAME=VerseMate
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Absolute base for links in emails (confirmation, password reset, coach portal)
APP_URL=http://localhost:5173

# Authentication
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_TO_A_UNIQUE_SECRET
AUTH_ACCESS_TOKEN_LIFETIME='1d'
AUTH_HASH_SALT=10

# Application
ENVIRONMENT=development
POSTGRES_URL=postgresql://postgres_user:postgres_password@localhost:5432/postgres_db
REDIS_URL="redis://:abcd1234@localhost:6379/0"
CORS_ALLOWED_ORIGINS=
# PEM CA certificate for a TLS Postgres (sslmode=require) and Redis (rediss://); unset verifies against the system CAs
# POSTGRES_CA_CERT=
# REDIS_CA_CERT=

# Object Storage
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET="saas-starter-dev"
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Open AI
OPEN_AI_KEY=""

# Explanation Audio (TTS)
# TTS_PROVIDER selects the synthesis backend. "stub" returns the fixture MP3
# for any request and bypasses the queue on the reader path; "openai" calls
# OpenAI's audio.speech API (requires OPEN_AI_KEY).
TTS_PROVIDER=stub
TTS_VOICE_EN=nova
TTS_MODEL_OPENAI=tts-1-hd
EXPLANATION_AUDIO_STUB_PATH=./fixtures/explanation-audio-stub.mp3

# SSO Authentication
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Origin of the admin app: SSO started there returns there; unset sends every SSO sign-in to FRONTEND_URL
# ADMIN_URL=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# PostHog Analytics (Backend/Server-side)
# Get your API key from https://app.posthog.com/project/settings
# IMPORTANT: Use separate PostHog projects for dev/staging vs production environments
# - This prevents test data from polluting production analytics
# - Create a separate project in PostHog for each environment
# - Leave empty to disable PostHog tracking (recommended for local development)
POSTHOG_KEY=""
# PostHog host URL (default: https://app.posthog.com for PostHog Cloud)
# Only change this if using self-hosted PostHog or EU cloud (https://eu.posthog.com)
POSTHOG_HOST="https://app.posthog.com"

# Bible Brain (Digital Bible Platform v4) — narrated scripture audio + text.
# Key request: https://4.dbt.io/api_key/request  (auth is the `key` query param, v=4)
# Licence: audio may be streamed; bytes may only be persisted via the /download
# endpoint, which is allowlisted per fileset (ESV/KJV/BSB yes, NLT/NKJV/CSB no).
# Bible content must not sit behind a paywall, and copyright must be user-visible.
BIBLE_BRAIN_API_KEY=

# Fireflies (coach session intake) — the recording bot's API key.
# Was /etc/fireflies-env on the retired coaching host. Intake polls team-wide
# transcripts (`mine: false`), which Fireflies grants only to an ADMIN key:
# there is no narrower read-only scope for team transcripts, so this key is
# broader than the pipeline needs. Recorded as an accepted risk, not an
# oversight. Unset = coach intake refuses to run, loudly.
FIREFLIES_API_KEY=

# Coach parallel run switch. Unset (or anything but "true") until cutover: the
# pipeline scores and stores sessions, its reports are visible to admins only,
# and no coach email is sent (delivery, re-share request, reminder). Set to
# true at the cutover step that stops the old host.
COACH_PIPELINE_LIVE=

# Where a leader's reply to any coach email lands. Unset = the legacy coach
# inbox, coach@versemate.org. One plain address.
COACH_REPLY_TO_EMAIL=coach@versemate.org

# Coach scheduled jobs, America/Chicago. Unset = the defaults shown.
# COACH_MONTHLY_CRON="0 9 1 * *"
# COACH_MONDAY_REMINDER_CRON="0 15 * * 1"

# Coach models, one setting each. Unset or empty = the default shown. The
# scoring model also judges Visual Aids from frames and names the leader of a
# rotating class. The transcription model must return timed segments, as
# whisper-1 does.
# COACH_SCORING_MODEL=gpt-6-astra
# COACH_BODY_MODEL=gpt-5
# COACH_MONTHLY_MODEL=gpt-5
# COACH_TRANSCRIBE_MODEL=whisper-1

# Coach scoring through the OpenAI Batch API, at half the price. Unset = on: a
# session with frames is sent as a batch and its report is published on a
# later tick, up to 24 hours later. false = score every session directly.
# COACH_SCORING_BATCH=false
