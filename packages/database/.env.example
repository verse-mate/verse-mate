# Email - NOTIFICATION (Google Workspace, Gmail API; queue/consumers/email-notification.consumer.ts)
# Sent only when ENVIRONMENT is production or staging. EMAIL_FROM is the Workspace mailbox the
# refresh token belongs to, or one of its verified "send mail as" aliases. The OAuth client is a
# Google Cloud "Desktop app" client; the refresh token is minted once for that mailbox with the
# scope https://www.googleapis.com/auth/gmail.send.
EMAIL_FROM=no-reply@example.org
EMAIL_FROM_NAME=VerseMate
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Absolute base for links in emails (confirmation, password reset, coach portal)
APP_URL=http://localhost:5173

# Authentication
AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_TO_A_UNIQUE_SECRET
AUTH_ACCESS_TOKEN_LIFETIME='1d'
AUTH_HASH_SALT=10

# Application
ENVIRONMENT=development
POSTGRES_URL=postgresql://postgres_user:postgres_password@localhost:5432/postgres_db
REDIS_URL="redis://:abcd1234@localhost:6379/0"

# Object Storage
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET="saas-starter-dev"
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
